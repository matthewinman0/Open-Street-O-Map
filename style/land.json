{
  "layers": [
    {
      "id": "paved-aeroways",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "aeroway",
      "filter": ["all"],
      "paint": {
        "fill-color": "#e4af7b",
        "fill-opacity": 1
      }
    },
    {
      "id": "paved-areas-outline",
      "type": "line",
      "source": "osm_areas",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "retail", "runway", "taxiway"],
      "paint": {
        "line-color": "#000000",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.5,
          14, 2.5,
          18, 8,
          19, 20
          ]
      }
    },
    {
      "id": "paved-areas",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "retail"],
      "paint": {
        "fill-color": "#e4af7b",
        "fill-opacity": 1
      }
    },
    {
      "id": "open areas",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "meadow", "farmland", "orchard", "golf_course"],
      "paint": {
        "fill-color": "#febe50",
        "fill-opacity": 1
      }
    },
    {
      "id": "rough-open",
      "type":"fill",
      "source": "osm_areas",
      "source-layer": "landcover",
      "filter": ["in", "subclass", "heath"],
      "paint": {
        "fill-color": "#ffdfa4",
        "fill-opacity": 1
      }
    },
    {
      "id": "OSM forest",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "filter": ["==", "subclass", "forest"],
      "paint": {
        "fill-color": "#ffffff"
      }
    },
    {
      "id": "GFC",
      "type": "raster",
      "source": "GFC2020 Terrain",
      "paint": {
        "raster-brightness-min": 1,
        "raster-brightness-max": 1,
        "raster-contrast": 0,
        "raster-saturation": -1,
        "raster-resampling": "linear"}
    },
    {
      "id": "tree-cover",
      "type": "raster",
      "source": "tree-cover"
    },
    {
      "id": "residential-areas",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "filter": ["==", "subclass", "residential"],
      "paint": {
        "fill-color": "#aba537",
        "fill-opacity": 1
      }
    },
    {
      "id": "osm-ways",
      "type": "line",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "paint": {
        "line-color": "#ff0000",
        "line-width": 2
      }
    },
    {
      "id": "farmland",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "filter": ["in", "subclass", "farmland"],
      "paint": {
        "fill-color": "#febe50",
        "fill-opacity": 1
      }
    },
    {
      "id": "rocks",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "landcover",
      "filter": ["in", "subclass", "rock"],
      "paint": {
        "fill-color": "#BCBCBC",
        "fill-opacity": 1
      }
    },
    {
      "id": "Vegetation",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "filter": ["in", "subclass", "scrub", "shrub"],
      "paint": {
        "fill-color": "#bef4b6",
        "fill-opacity": 1
      }
    },
    {
      "id": "pitches",
      "type": "fill",
      "source": "osm_areas",
      "source-layer": "osm_areas",
      "filter": ["in", "class", "pitch", "playground"],
      "paint": {
        "fill-color": "#c07635",
        "fill-opacity": 1
      }
    },
    {
      "id": "ditches",
      "type": "line",
      "source": "osm",
      "source-layer": "osm_ways",
      "filter": ["==", "subclass", "ditch"],
      "layout": {"line-cap": "round"},
      "paint": {
        "line-color": "#D07500",
        "line-opacity": 1,
        "line-dasharray": [0.5, 3],
        "line-width": [
              "interpolate",
              ["linear"],
              ["zoom"],
              10, 0.4,
              14, 1,
              18, 10,
              19, 20
              ]

      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "hillshade",
      "layout": {
          "visibility": "visible"
      },
      "paint": {
          "hillshade-shadow-color": "#473B24"
      }
    }
  ]
}